extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug

block main
    if(role.permissions.includes("restore_view"))
        +alert-success("5000")
        +alert-error("5000")
        h1(class="mb-4") #{pageTitle}
            form(
                action=`${prefixAdmin}/restored/${productRecords.id}?_method=PATCH`
                id="form-restored"
                method="POST"
            )
        .card.mb-3
            .card-header Thanh Tìm kiếm
                .card-body
                    .row
                        .col-6 
                            +search(keyword)
        .card.mb-3
            .card-header Danh sách sản phẩm đã xóa
            .card-body
                .row 
                table(
                    class="table table-hover table-sm"
                    checkbox-multi
                )
                    thead
                    tr
                        th STT
                        th Hình ảnh
                        th Tiêu đề
                        if(role.permissions.includes("restore_restored"))
                            th Trạng thái

                    tbody
                    each item, index in productRecords 
                        tr 
                        td #{index + 1}
                        td
                            img(
                            src=item.thumbnail
                            alt=item.title
                            width="100px"
                            height="auto"
                            )
                        td #{item.title}
                        if(role.permissions.includes("restore_restored"))
                            td
                                button(
                                    type="submit"
                                    class="btn btn-info btn-sm ml-1"
                                    data-id = item.id 
                                    button-restored 
                                ) Khôi phục
                +pagination(pagination)
            script(src="/admin/js/product.js")
    else 
        h1(class="mb-4") Bạn không có quyền truy cập trang này